{
  "npm": {
    "version": "https://img.shields.io/npm/v/{package}",
    "downloads": "https://img.shields.io/npm/dm/{package}",
    "bundle_size": "https://img.shields.io/bundlephobia/minzip/{package}"
  },
  "pypi": {
    "version": "https://img.shields.io/pypi/v/{package}",
    "downloads": "https://img.shields.io/pypi/dm/{package}",
    "python_version": "https://img.shields.io/pypi/pyversions/{package}"
  },
  "crates": {
    "version": "https://img.shields.io/crates/v/{package}",
    "downloads": "https://img.shields.io/crates/d/{package}"
  },
  "go": {
    "version": "https://img.shields.io/github/v/tag/{owner}/{repo}",
    "reference": "https://pkg.go.dev/badge/{module}.svg",
    "report_card": "https://goreportcard.com/badge/github.com/{owner}/{repo}"
  },
  "rubygems": {
    "version": "https://img.shields.io/gem/v/{package}",
    "downloads": "https://img.shields.io/gem/dt/{package}"
  },
  "pub": {
    "version": "https://img.shields.io/pub/v/{package}",
    "points": "https://img.shields.io/pub/points/{package}",
    "likes": "https://img.shields.io/pub/likes/{package}"
  },
  "packagist": {
    "version": "https://img.shields.io/packagist/v/{vendor}/{package}",
    "downloads": "https://img.shields.io/packagist/dm/{vendor}/{package}",
    "php_version": "https://img.shields.io/packagist/dependency-v/{vendor}/{package}/php"
  },
  "maven": {
    "version": "https://img.shields.io/maven-central/v/{groupId}/{artifactId}",
    "downloads": "https://img.shields.io/maven-central/dm/{groupId}/{artifactId}"
  },
  "hex": {
    "version": "https://img.shields.io/hexpm/v/{package}",
    "downloads": "https://img.shields.io/hexpm/dt/{package}"
  },
  "hackage": {
    "version": "https://img.shields.io/hackage/v/{package}",
    "deps": "https://img.shields.io/hackage-deps/v/{package}"
  },
  "github": {
    "license": "https://img.shields.io/github/license/{owner}/{repo}",
    "ci": "https://img.shields.io/github/actions/workflow/status/{owner}/{repo}/{workflow}",
    "stars": "https://img.shields.io/github/stars/{owner}/{repo}",
    "last_commit": "https://img.shields.io/github/last-commit/{owner}/{repo}",
    "issues": "https://img.shields.io/github/issues/{owner}/{repo}",
    "release": "https://img.shields.io/github/v/release/{owner}/{repo}",
    "contributors": "https://img.shields.io/github/contributors/{owner}/{repo}"
  }
}
